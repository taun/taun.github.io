---
permalink: /feed.xml
eleventyExcludeFromCollections: true
eleventyImport:
  collections: ["feed"]
---
<?xml version="1.0" encoding="utf-8"?>
{% from "node-parts.njk" import mediaLinksHtml, galleryHtml %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xmlChars("site.json") }}</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>{{ site.tagline | xmlChars("site.json") }}</description>
    <language>en</language>
    {%- for item in collections.feed %}
    {%- set url = site.url + item.url %}
    {# Front matter the page shows but the Markdown body does not contain. Feed readers run no scripts, so video is a link. #}
    {%- set html %}
      {% if item.data.header and item.data.header.image %}<p><img src="{{ item.data.header.image }}" alt=""></p>{% endif %}
      {{ mediaLinksHtml((item.fileSlug | nodeInfo).media, plain=true) }}
      {{ item.content | safe }}
      {{ galleryHtml(item.data.gallery, item.data.galleryCaption) }}
    {% endset %}
    <item>
      <title>{{ (item.data.title or item.fileSlug) | xmlChars(item.fileSlug) }}</title>
      <link>{{ url }}</link>
      <guid isPermaLink="true">{{ url }}</guid>
      <pubDate>{{ item.data.published | feedDate }}</pubDate>
      <description>{{ html | renderTransforms(item.data.page, site.url + "/") | xmlChars(item.fileSlug) | escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
