<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ summary or site.tagline }}">
  <link rel="stylesheet" href="/css/site.css?v={{ buildStamp }}">
  <link rel="stylesheet" href="/css/types.css?v={{ buildStamp }}">
  {% if hero %}<script>
    // Apply the query's view and hero before first paint so the page does not flash the default view (view.js does the rest).
    (() => {
      const p = new URLSearchParams(location.search), r = document.documentElement;
      r.dataset.view = p.get('view') || 'list';
      if (/^(0|false)$/.test(p.get('hero') || '')) r.classList.add('no-hero');
      if (p.get('q')) r.classList.add('searching');
    })();
  </script>{% endif %}
</head>
{# site.hero "top": the home image (no text) goes above the header, the site title is the home page's h1, and the tagline moves to the footer. #}
{% set heroTop = site.hero == "top" %}
<body class="{{ bodyClass }}{% if heroTop %} hero-top{% endif %}">
  {% if heroTop and hero and header and header.image %}<img class="hero-image" src="{{ header.image }}" alt="">{% endif %}
  <header class="site-header">
    {% if heroTop and hero %}<h1 class="brand"><a href="/">{{ site.title }}</a></h1>{% else %}<a class="brand" href="/">{{ site.title }}</a>{% endif %}
    <nav aria-label="Main">
      {# A menu entry with an icon (a file in _includes/icons/) shows the icon, with its label as the accessible name. #}
      {% for m in site.menu %}<a href="/{% if m.query %}?{{ m.query }}{% endif %}"{% if m.icon %} class="icon-link" aria-label="{{ m.label }}" title="{{ m.label }}"{% endif %}>{% if m.icon %}{% include "icons/" + m.icon + ".svg" %}{% else %}{{ m.label }}{% endif %}</a>
      {% endfor %}
      {# Search: opened by the icon (search.js). On the home page it filters live (view.js); elsewhere it submits to the home list. #}
      <form class="search" action="/" method="get" role="search">
        <input id="q" name="q" type="search" autocomplete="off" placeholder="Search titles and tags" aria-label="Search titles and tags">
        <input type="hidden" name="hero" value="0">
        <button type="button" class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="q">{% include "icons/search.svg" %}</button>
      </form>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    {% if heroTop %}<p class="tagline">{{ site.tagline }}</p>{% endif %}
    {% for l in site.links %}<a href="{{ l.url }}" rel="me">{{ l.label }}</a>{% endfor %}
  </footer>
  <script src="/js/search.js?v={{ buildStamp }}" defer></script>
  {% if scripts %}{% for s in scripts %}<script src="{{ s }}?v={{ buildStamp }}" defer></script>{% endfor %}{% endif %}
</body>
</html>
