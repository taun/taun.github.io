<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ summary or site.tagline }}">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/types.css">
</head>
{# site.hero "top": the home image (no text) goes above the header, the site title is the home page's h1, and the tagline moves to the footer. #}
{% set heroTop = site.hero == "top" %}
<body class="{{ bodyClass }}{% if heroTop %} hero-top{% endif %}">
  {% if heroTop and hero and header and header.image %}<img class="hero-image" src="{{ header.image }}" alt="">{% endif %}
  <header class="site-header">
    {% if heroTop and hero %}<h1 class="brand"><a href="/">{{ site.title }}</a></h1>{% else %}<a class="brand" href="/">{{ site.title }}</a>{% endif %}
    <nav aria-label="Main">
      <a href="/">Blog</a>
      <a href="/talks/">Talks</a>
      <a href="/cv/">CV</a>
      <a href="/connections/">Connections</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    {% if heroTop %}<p class="tagline">{{ site.tagline }}</p>{% endif %}
    {% for l in site.links %}<a href="{{ l.url }}" rel="me">{{ l.label }}</a>{% endfor %}
  </footer>
  {% if scripts %}{% for s in scripts %}<script src="{{ s }}" defer></script>{% endfor %}{% endif %}
</body>
</html>
