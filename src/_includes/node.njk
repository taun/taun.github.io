---
layout: base.njk
---
{% set slug = page.fileSlug %}
{% set rec = slug | nodeInfo %}
<article class="prose node">
  {% if header and header.image %}<img class="banner" src="{{ header.image }}" alt="">{% endif %}
  <p class="meta">
    {% if rec %}<span class="chip type-{{ rec.typeKey }}">{{ rec.type }}</span>{% endif %}
    {% if rec and rec.dateLabel %}<time datetime="{{ rec.date }}">{{ rec.dateLabel }}</time>{% else %}<span class="muted">undated</span>{% endif %}
    {% for t in tags %}<span class="tag">#{{ t }}</span>{% endfor %}
  </p>
  <h1>{{ title }}</h1>
  {% if rec %}{% set m = rec.media %}
  {% if m.video or m.archive or m.slides or m.repo %}
  <p class="media-links">
    {% if m.video %}<a href="{{ m.video.url }}"{% if m.video.kind != 'file' %} target="_blank" rel="noopener noreferrer"{% endif %}>▶ Watch{% if m.video.kind == 'youtube' %} on YouTube{% endif %}{% if m.video.kind != 'file' %} <span class="ext" aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>{% endif %}</a>{% endif %}
    {% if m.archive %}<a href="{{ m.archive.url }}">⤓ Archived copy</a>{% endif %}
    {% if m.slides %}<a href="{{ m.slides }}">▤ Slides</a>{% endif %}
    {% if m.repo %}<a href="{{ m.repo }}" target="_blank" rel="noopener noreferrer">⌥ Source <span class="ext" aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>{% endif %}
  </p>
  {% endif %}
  {% if m.video.kind == 'youtube' %}
  <div class="video" data-yt="{{ m.video.id }}">
    <button type="button" class="video-play" aria-label="Play video: {{ title }}">
      <img src="https://i.ytimg.com/vi/{{ m.video.id }}/hqdefault.jpg" alt="" loading="lazy"><span aria-hidden="true">▶</span>
    </button>
  </div>
  {% elif m.video.kind == 'file' %}
  <video class="video" controls preload="metadata" src="{{ m.video.url }}"></video>
  {% elif m.archive.kind == 'file' %}
  <video class="video" controls preload="metadata" src="{{ m.archive.url }}"></video>
  {% endif %}
  {% endif %}
  {{ content | safe }}

  {% if gallery %}
  <section class="gallery" aria-label="Gallery">
    {% for g in gallery %}
      {% if (g.image_path or g.url) | isImage %}
      <figure><a href="{{ g.url }}"><img src="{{ g.image_path or g.url }}" alt="{{ g.alt }}" loading="lazy"></a></figure>
      {% else %}
      <figure class="file"><a href="{{ g.url }}">▤ {{ g.alt or g.url }}</a></figure>
      {% endif %}
    {% endfor %}
    {% if galleryCaption %}<p class="caption">{{ galleryCaption }}</p>{% endif %}
  </section>
  {% endif %}
</article>

{% set rels = slug | relations %}
{% set st = slug | sharedTags %}
{% if rels.length or st.length %}
<aside class="connections prose">
  {% for g in rels %}
  <h2><span class="dir" aria-hidden="true">{{ "→" if g.dir == "out" else "←" }}</span> {{ g.label }}</h2>
  <ul class="cards">
    {% for n in g.items %}<li><a href="{{ n.url }}"><span class="chip type-{{ n.typeKey }}">{{ n.type }}</span> {{ n.title }}</a>{% if n.dateLabel %} <span class="muted">{{ n.dateLabel }}</span>{% endif %}</li>{% endfor %}
  </ul>
  {% endfor %}
  {% if st.length %}
  <h2>Same tags</h2>
  <ul class="cards">
    {% for n in st %}<li><a href="{{ n.url }}">{{ n.title }}</a></li>{% endfor %}
  </ul>
  {% endif %}
</aside>
{% endif %}
