---
layout: base.njk
bodyClass: home
scripts: ["/js/graph.js", "/js/view.js"]
hero: true
---
{# One page, several views. view.js picks the view and filters from the query (see README); every view is built here so the page also works without JavaScript (the list shows). #}
{% if site.hero != "top" %}
<section class="hero{% if header and header.image %} hero-banner{% endif %}"{% if header and header.image %} style="background-image: url('{{ header.image }}')"{% endif %}>
  <div class="hero-inner">
    {% set cut = site.title.lastIndexOf(" ") + 1 %}
    <h1 title="{{ site.title }}"><span class="trunc-head">{{ site.title.slice(0, cut) }}</span><span class="trunc-tail">{{ site.title.slice(cut) }}</span></h1>
    <p>{{ site.tagline }}</p>
  </div>
</section>
{% endif %}
<section class="prose welcome">
  {{ content | safe }}
</section>
<div class="prose controls">
  <p class="views" role="group" aria-label="View">
    <button type="button" class="chip" data-view="list" aria-pressed="true">List</button>
    <button type="button" class="chip" data-view="timeline" aria-pressed="false">Timeline</button>
    <button type="button" class="chip" data-view="connections" aria-pressed="false">Connections</button>
  </p>
  <p class="filters" role="group" aria-label="Types">
    {% for t in collections.graph | types %}
    <button type="button" class="chip type-{{ t | typeKey }}" data-type="{{ t }}" aria-pressed="false">{{ t }}</button>
    {% endfor %}
  </p>
  <details class="tag-filters">
    <summary>Tags</summary>
    <p class="filters" role="group" aria-label="Tags">
      {% for t in collections.graph | tagList %}
      <button type="button" class="chip tag" data-tag="{{ t }}" aria-pressed="false">#{{ t }}</button>
      {% endfor %}
    </p>
  </details>
</div>

<article class="prose view view-list">
  {% for g in collections.graph | byFiveYears %}
  <section class="group">
    <h2>{{ g.label }}</h2>
    <ul class="cards">
      {% for n in g.items %}
      <li data-slug="{{ n.slug }}">
        <a href="{{ n.url }}"><span class="chip type-{{ n.typeKey }}">{{ n.type }}</span> {{ n.title }}</a>
        {% if n.dateLabel %}<span class="muted">{{ n.dateLabel }}</span>{% endif %}
        {% include "item-media.njk" %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</article>

<article class="prose view view-timeline">
  <ol class="timeline">
  {% for g in collections.graph | byYear %}
    <li class="group">
      <h2>{{ g.label }}</h2>
      <ul class="cards">
        {% for n in g.items %}
        <li data-slug="{{ n.slug }}"><a href="{{ n.url }}"><span class="chip type-{{ n.typeKey }}">{{ n.type }}</span> {{ n.title }}</a>
          {% if n.dateLabel and n.dateLabel != g.label %}<span class="muted">{{ n.dateLabel }}</span>{% endif %}
          {% if n.summary %}<br><span class="muted">{{ n.summary }}</span>{% endif %}
          {% include "item-media.njk" %}</li>
        {% endfor %}
      </ul>
    </li>
  {% endfor %}
  </ol>
</article>

<div class="view view-connections">
  {% include "graph-embed.njk" %}
</div>
