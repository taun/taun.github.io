---
layout: base.njk
title: Blog
permalink: /blog/
scripts: ["/js/list.js"]
---
<article class="prose">
  <h1>Blog</h1>
  <p><input id="q" type="search" placeholder="Filter by title or tag" aria-label="Filter"></p>
  <p class="filters">
    {% for t in collections.graph | types %}
    <button type="button" class="chip type-{{ t }}" data-type="{{ t }}" aria-pressed="false">{{ t }}</button>
    {% endfor %}
  </p>
  <div id="items">
    {% for g in collections.graph | byFiveYears %}
    <section class="group">
      <h2>{{ g.label }}</h2>
      <ul class="cards">
        {% for n in g.items %}
        <li data-type="{{ n.type }}" data-text="{{ n.title | lower }} {{ n.tags | join(' ') }}">
          <a href="{{ n.url }}"><span class="chip type-{{ n.type }}">{{ n.type }}</span> {{ n.title }}</a>
          {% if n.dateLabel %}<span class="muted">{{ n.dateLabel }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>
</article>
